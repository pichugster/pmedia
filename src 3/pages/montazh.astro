---
import Base from "../layouts/Base.astro";
import ProductLadder from "../components/ProductLadder.astro";
import { getCollection } from "astro:content";
import { RUBRICS } from "../data/rubrics.js";
const RUBRIC = "montazh";
const r = RUBRICS[RUBRIC];
const guides = (await getCollection("guides", ({ data }) => !data.draft && data.rubric === RUBRIC))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${r.title} · pichugster`} description={r.intro} current={r.path}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>{r.label}</span>
      <h1>{r.title}</h1>
      <p>{r.intro}</p>
    </div>
  </section>

  <section class="band" style="padding-top:48px;padding-bottom:40px">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:28px">
        <span class="eyebrow"><span class="dot"></span>Бесплатные материалы</span>
        <h2>Полезные статьи и гайды</h2>
      </div>
      <div class="guide-grid">
        {guides.map((g) => (
          <a class="guide-card" href={`/guide/${g.slug}`}>
            <span class="cat">{g.data.category}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
          </a>
        ))}
      </div>
      {guides.length === 0 && <p class="empty">Первые статьи уже в работе — скоро появятся здесь.</p>}
    </div>
  </section>

  <ProductLadder rubric={RUBRIC} />

  <section class="band" style="padding-top:20px">
    <div class="wrap" style="text-align:center;max-width:620px;margin:0 auto">
      <h2 style="font-family:var(--display);font-weight:600;font-size:1.6rem;letter-spacing:-.01em;margin-bottom:10px">Не пропусти запуск продуктов</h2>
      <p style="color:var(--slate);margin-bottom:22px">Подпишись — пришлю бесплатный гайд и сообщу, когда открою платные материалы.</p>
      <a class="btn btn-primary" href="/#sub">Подписаться</a>
    </div>
  </section>
</Base>
