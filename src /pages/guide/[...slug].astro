---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { RUBRICS } from "../../data/rubrics.js";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((g) => ({ params: { slug: g.slug }, props: { guide: g } }));
}
const { guide } = Astro.props;
const { Content } = await guide.render();
const r = RUBRICS[guide.data.rubric] || { label: "На главную", path: "/" };
const dateStr = guide.data.date.toLocaleDateString("ru-RU", { year: "numeric", month: "long", day: "numeric" });
---
<Base title={`${guide.data.title} · pichugster`} description={guide.data.description}>
  <article class="article">
    <a class="back" href={r.path}>← {r.label}</a>
    <span class="cat">{guide.data.category}</span>
    <h1>{guide.data.title}</h1>
    <div class="meta">{dateStr}</div>
    <div class="prose"><Content /></div>
  </article>
</Base>
