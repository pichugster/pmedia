---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const guides = (await getCollection("guides", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Гайды по нейросетям и заработку · pichugster" current="/gaydy">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>Гайды</span>
      <h1>Пошаговые <span class="warm">инструкции</span> без воды</h1>
      <p>Как освоить нейросети, начать зарабатывать и собрать первый контент. Каждый гайд — конкретные шаги, а не теория.</p>
    </div>
  </section>

  <section class="band" style="padding-top:48px">
    <div class="wrap">
      <div class="guide-grid">
        {guides.map((g) => (
          <a class="guide-card" href={`/gaydy/${g.slug}`}>
            <span class="cat">{g.data.category}</span>
            <h3>{g.data.title}</h3>
            <p>{g.data.description}</p>
          </a>
        ))}
      </div>
      {guides.length === 0 && <p class="empty">Гайды скоро появятся.</p>}
    </div>
  </section>
</Base>
