---
import Base from "../layouts/Base.astro";
import ProductLadder from "../components/ProductLadder.astro";
import countries from "../data/countries.json";

const filters = [
  { key: "all",     label: "Все" },
  { key: "novichok", label: "Новичкам" },
  { key: "ai",      label: "AI-фриланс" },
  { key: "montazh", label: "Монтаж" },
  { key: "blog",    label: "Блог" },
  { key: "budget",  label: "Низкие цены" },
];

const tagLabels = { ai: "AI", montazh: "монтаж", blog: "блог", novichok: "новичкам", budget: "бюджетно" };
---
<Base title="Страны для удалённой жизни — каталог · pichugster" current="/strany">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>Каталог стран</span>
      <h1>Куда переехать и <span class="warm">работать удалённо</span></h1>
      <p>Сравни страны по визе для удалёнщиков, стоимости жизни, интернету и комьюнити. Фильтруй под свою задачу — AI, монтаж или блог.</p>
    </div>
  </section>

  <section class="band" style="padding-top:40px">
    <div class="wrap">
      <div class="filters" id="filters">
        {filters.map((f) => (
          <button class:list={["filter", { active: f.key === "all" }]} data-filter={f.key}>{f.label}</button>
        ))}
      </div>

      <div class="country-grid" id="grid">
        {countries.map((c) => (
          <article class="country-card" data-tags={c.tags.join(",")}>
            <div class="cc-head"><span>{c.flag} {c.name}</span><span>легко · {c.ease}/5</span></div>
            <div class="cc-row"><span>Виза удалёнщику</span><b class="ok">{c.visa}</b></div>
            <div class="cc-row"><span>Жизнь / мес</span><b>{c.cost}</b></div>
            <div class="cc-row"><span>Интернет</span><b>{c.internet}</b></div>
            <div class="cc-row"><span>Комьюнити</span><b>{c.community}</b></div>
            <div class="cc-tags">
              {c.tags.map((t) => (<span class="cc-tag">{tagLabels[t] || t}</span>))}
            </div>
          </article>
        ))}
      </div>
      <p class="empty" id="empty" style="display:none">Под этот фильтр пока нет стран — добавим.</p>

      <p class="empty" style="margin-top:40px">⚠️ Данные по визам и ценам — стартовые ориентиры. Перед переездом всегда проверяй актуальные требования на официальных источниках.</p>
    </div>
  </section>

  <script>
    const buttons = document.querySelectorAll('#filters .filter');
    const cards = Array.from(document.querySelectorAll('#grid .country-card'));
    const empty = document.getElementById('empty');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        const f = btn.getAttribute('data-filter');
        let shown = 0;
        cards.forEach((card) => {
          const tags = (card.getAttribute('data-tags') || '').split(',');
          const show = f === 'all' || tags.includes(f);
          card.style.display = show ? '' : 'none';
          if (show) shown++;
        });
        empty.style.display = shown === 0 ? 'block' : 'none';
      });
    });
  </script>

  <ProductLadder rubric="strany" />
</Base>
