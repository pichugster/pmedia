---
import Base from "../layouts/Base.astro";

// === ФОРМА ЗАЯВОК === вставь ТОТ ЖЕ код Formspree, что и в montazh.astro
const FORM_ENDPOINT = "https://formspree.io/f/REPLACE_ME";

// === ПРИМЕРЫ РАБОТ (заглушки) ===
const works = [
  { title: "Карточка товара", note: "фон + инфографика", price: "от 500 ₽", icon: "🛍️" },
  { title: "Рекламный баннер", note: "для соцсетей и рекламы", price: "от 700 ₽", icon: "🎨" },
  { title: "AI-видео", note: "короткий ролик", price: "от 2 000 ₽", icon: "🎬" },
];

// === УСЛУГИ: заказать у меня ИЛИ научиться самому (ведёт в обучение) ===
const services = [
  { title: "Карточки товаров", desc: "Продающие карточки для маркетплейсов: фон, сцены, инфографика.", learn: "/zarabotok/ai-foto" },
  { title: "Замена фона и предметка", desc: "Чистый или сюжетный фон, ретушь, товар «в жизни».", learn: "/zarabotok/ai-foto" },
  { title: "AI-видео и ролики", desc: "Рекламные ролики, аватары, короткие вертикальные видео.", learn: "/zarabotok/ai-video" },
  { title: "Дизайн и баннеры", desc: "Баннеры, обложки, визуал для соцсетей и рекламы.", learn: "/zarabotok/design" },
  { title: "Инфографика для маркетплейсов", desc: "Понятная инфографика, которая поднимает конверсию.", learn: "/zarabotok/marketplaces" },
];
---
<Base title="AI-услуги под ключ · pichugster" description="Визуал, видео и дизайн с нейросетями: карточки товаров, баннеры, ролики. Закажи под ключ или научись сам." current="/uslugi">
  <section class="m-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>Услуги</span>
      <h1>AI-услуги под ключ</h1>
      <p class="lede">Визуал, видео и дизайн с нейросетями — для бизнеса и маркетплейсов. Закажи у меня или научись делать так же сам.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#order">Заказать услугу</a>
        <a class="btn btn-ghost" href="/zarabotok">📚 Научиться самому</a>
      </div>
    </div>
  </section>

  <section class="band" style="padding-top:48px;padding-bottom:40px">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:24px">
        <span class="eyebrow"><span class="dot"></span>Примеры работ</span>
        <h2>Что я делаю</h2>
        <p>Реальные примеры и ориентир по цене.</p>
      </div>
      <div class="work-grid">
        {works.map((w) => (
          <div class="work-card">
            <div class="work-thumb"><span>{w.icon}</span></div>
            <div class="work-body">
              <h3>{w.title}</h3>
              <p>{w.note}</p>
              <span class="price">{w.price}</span>
            </div>
          </div>
        ))}
      </div>
      <p class="muted" style="margin-top:14px">Скоро здесь появятся реальные кейсы до / после.</p>
    </div>
  </section>

  <section id="services" class="band" style="padding-top:0;padding-bottom:40px">
    <div class="wrap">
      <div class="sec-head" style="margin-bottom:24px">
        <span class="eyebrow"><span class="dot"></span>Два пути</span>
        <h2>Закажи у меня или научись сам</h2>
        <p>Сделаю под ключ — или покажу, как сделать это самому.</p>
      </div>
      <div class="svc-list">
        {services.map((s) => (
          <div class="svc-card">
            <div class="svc-head">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
            <div class="svc-paths">
              <div class="path">
                <div class="path-title">🤝 Сделаю за вас</div>
                <div class="path-desc">Пришлёшь задачу — верну готовый результат.</div>
                <a class="btn btn-primary btn-sm" href="#order">Заказать</a>
              </div>
              <div class="path">
                <div class="path-title">📘 Научиться так же самому</div>
                <div class="path-desc">Бесплатные статьи и гайды в обучающем разделе.</div>
                <a class="btn btn-ghost btn-sm" href={s.learn}>Научиться →</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="order" class="band band-soft" style="padding-top:48px;padding-bottom:52px">
    <div class="wrap" style="max-width:560px;margin:0 auto">
      <div class="sec-head" style="margin-bottom:22px;text-align:center">
        <span class="eyebrow" style="justify-content:center"><span class="dot"></span>Заказать услугу</span>
        <h2>Оставь заявку</h2>
        <p>Заполни — отвечу и обсудим задачу. Это ни к чему не обязывает.</p>
      </div>
      <form id="order-form" action={FORM_ENDPOINT} method="POST" class="order-form">
        <input type="hidden" name="_subject" value="Новая заявка: AI-услуга — pichugster" />
        <input type="text" name="name" placeholder="Как тебя зовут" required />
        <input type="text" name="contact" placeholder="Telegram или почта для связи" required />
        <textarea name="message" placeholder="Что нужно сделать? Опиши задачу, дай ссылку на товар/материал." rows="4" required></textarea>
        <button type="submit" class="btn btn-primary">Отправить заявку</button>
        <p id="order-status" class="order-status"></p>
      </form>
    </div>
  </section>
</Base>

<style>
  .m-hero{position:relative;padding:84px 0 64px;background:
    linear-gradient(135deg,rgba(6,182,212,.10),rgba(91,124,240,.10) 40%,rgba(179,107,224,.10) 70%,rgba(255,143,168,.12));
    border-bottom:1px solid var(--line)}
  .m-hero h1{font-family:var(--display);font-weight:700;font-size:2.7rem;line-height:1.06;letter-spacing:-.02em;margin:14px 0 14px}
  .m-hero .lede{font-size:1.12rem;color:var(--slate);max-width:560px;margin-bottom:26px}
  .cta-row{display:flex;gap:12px;flex-wrap:wrap}
  .btn-sm{padding:9px 16px;font-size:.92rem}

  .work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .work-card{border:1px solid var(--line);border-radius:16px;overflow:hidden;background:var(--panel)}
  .work-thumb{height:130px;display:flex;align-items:center;justify-content:center;font-size:2.4rem;
    background:linear-gradient(135deg,#06B6D4,#5B7CF0 45%,#B36BE0 75%,#FF8FA8)}
  .work-body{padding:14px 16px}
  .work-body h3{font-family:var(--display);font-weight:600;font-size:1.05rem;margin-bottom:3px}
  .work-body p{font-size:.9rem;color:var(--slate);margin-bottom:8px}
  .price{font-family:var(--mono);font-size:.82rem;color:var(--sky);font-weight:600}

  .svc-list{display:flex;flex-direction:column;gap:16px}
  .svc-card{border:1px solid var(--line);border-radius:18px;background:var(--panel);padding:22px 24px}
  .svc-head h3{font-family:var(--display);font-weight:600;font-size:1.25rem;margin-bottom:4px}
  .svc-head p{color:var(--slate);margin-bottom:16px}
  .svc-paths{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .path{border:1px solid var(--line);border-radius:14px;padding:16px}
  .path-title{font-family:var(--display);font-weight:600;font-size:1rem;margin-bottom:6px}
  .path-desc{font-size:.9rem;color:var(--slate);margin-bottom:14px}

  .band-soft{background:linear-gradient(135deg,rgba(6,182,212,.07),rgba(179,107,224,.07) 70%,rgba(255,143,168,.09))}
  .order-form{display:flex;flex-direction:column;gap:12px}
  .order-form input,.order-form textarea{width:100%;padding:13px 15px;border:1px solid var(--line);border-radius:12px;
    font:inherit;font-size:1rem;background:#fff;color:var(--midnight);resize:vertical}
  .order-form input:focus,.order-form textarea:focus{outline:none;border-color:var(--sky);box-shadow:0 0 0 3px rgba(37,99,235,.12)}
  .order-form .btn{margin-top:4px}
  .order-status{text-align:center;font-size:.95rem;margin-top:6px;min-height:1.2em}
  .order-status.ok{color:#0F766E}
  .order-status.err{color:#DC2626}

  @media(max-width:900px){.work-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:680px){.svc-paths{grid-template-columns:1fr}}
  @media(max-width:560px){.work-grid{grid-template-columns:1fr}.m-hero h1{font-size:2.1rem}}
</style>

<script is:inline>
  const form = document.getElementById('order-form');
  const statusEl = document.getElementById('order-status');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (form.action.includes('REPLACE_ME')) {
        statusEl.textContent = 'Форма ещё не подключена.';
        statusEl.className = 'order-status err';
        return;
      }
      statusEl.textContent = 'Отправляю…';
      statusEl.className = 'order-status';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (res.ok) {
          form.reset();
          statusEl.textContent = 'Заявка отправлена — скоро отвечу. Спасибо!';
          statusEl.className = 'order-status ok';
        } else {
          statusEl.textContent = 'Не удалось отправить. Попробуй ещё раз позже.';
          statusEl.className = 'order-status err';
        }
      } catch {
        statusEl.textContent = 'Не удалось отправить. Проверь соединение.';
        statusEl.className = 'order-status err';
      }
    });
  }
</script>
