---
import Base from "../layouts/Base.astro";
import { GROUPS } from "../data/zarabotok.js";
---
<Base title="Заработок на нейросетях · pichugster" description="Каталог направлений заработка с AI: услуги для бизнеса, контент, свои продукты, обучение, агентства." current="/zarabotok">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>Заработок на ИИ</span>
      <h1>Заработок на нейросетях</h1>
      <p>Выбери направление — внутри конкретные услуги, а в каждой услуге бесплатная статья и подробный гайд.</p>
    </div>
  </section>
  <section class="band" style="padding-top:40px">
    <div class="wrap">
      {GROUPS.map((group) => (
        <div class="napr-group">
          <h2 class="napr-group-title">{group.title}</h2>
          <div class="guide-grid">
            {group.items.map((n) => (
              <a class="guide-card" href={`/zarabotok/${n.slug}`}>
                <span class="cat">{n.services.length} услуг</span>
                <h3>{n.title}</h3>
                <p>{n.desc}</p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
<style>
  .napr-group{margin-bottom:42px}
  .napr-group-title{font-family:var(--display);font-weight:600;font-size:1.25rem;letter-spacing:-.01em;margin-bottom:18px}
</style>
