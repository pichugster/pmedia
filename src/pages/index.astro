<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>pichugster — твой проводник по Вьетнаму и удалённой жизни</title>
<meta name="description" content="Портал-проводник по Нячангу и удалённой жизни. Ответь на пару вопросов — получи персональную подборку под себя.">
<meta name="theme-color" content="#0A0E16">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#0A0E16; --bg2:#0E1524; --surface:#131C2E; --surface2:#0F1826;
    --line:rgba(255,255,255,.09); --line2:rgba(255,255,255,.16);
    --text:#EAEEF7; --muted:#8B97AD; --sky:#5B8CFF; --cyan:#22D3EE;
    --grad:linear-gradient(120deg,#06B6D4 0%,#5B7CF0 42%,#B36BE0 72%,#FF8FA8 100%);
    --display:"Quicksand",system-ui,sans-serif; --body:"Inter",system-ui,sans-serif;
    --mono:ui-monospace,Menlo,monospace; --maxw:1080px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden;min-height:100vh}
  ::selection{background:#5B7CF0;color:#fff}
  a{color:inherit;text-decoration:none}
  button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
  .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  :focus-visible{outline:2px solid var(--sky);outline-offset:3px;border-radius:8px}

  /* фон: свечение + сетка + птица */
  .bgfx{position:fixed;inset:0;z-index:0;pointer-events:none;
    background:
      radial-gradient(60% 50% at 50% -5%,rgba(91,124,240,.20),transparent 70%),
      radial-gradient(40% 40% at 90% 10%,rgba(179,107,224,.12),transparent 70%),
      linear-gradient(rgba(255,255,255,.022) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.022) 1px,transparent 1px),
      var(--bg);
    background-size:auto,auto,48px 48px,48px 48px,auto}
  .bird{position:fixed;z-index:0;top:14%;right:6%;width:min(38vw,440px);opacity:.06;pointer-events:none}
  .bird path{fill:url(#bg)}

  nav{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:20px 24px;max-width:var(--maxw);margin:0 auto}
  .brand{display:flex;align-items:center;gap:10px;font-family:var(--display);font-weight:700;font-size:1.15rem}
  .brand img{height:30px;width:auto}
  .nav-right{font-family:var(--mono);font-size:.7rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted)}

  main{position:relative;z-index:5}
  .hero{max-width:var(--maxw);margin:0 auto;padding:clamp(30px,7vh,80px) 24px 80px;text-align:center}
  .eyebrow{font-family:var(--mono);font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;color:var(--sky)}
  .hero h1{font-family:var(--display);font-weight:700;font-size:clamp(2.1rem,5.4vw,3.6rem);line-height:1.05;letter-spacing:-.02em;margin:18px auto 16px;max-width:16ch}
  .hero .lede{color:var(--muted);font-size:clamp(1rem,1.6vw,1.15rem);max-width:46ch;margin:0 auto 8px}

  /* конструктор */
  .builder{margin-top:44px;min-height:340px;position:relative}
  .screen{display:none}
  .screen.active{display:block;animation:enter .5s cubic-bezier(.16,1,.3,1)}
  @keyframes enter{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}

  .qhead{font-family:var(--display);font-weight:600;font-size:clamp(1.3rem,2.6vw,1.8rem);margin-bottom:6px}
  .qsub{color:var(--muted);font-size:.95rem;margin-bottom:28px}

  .qgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:820px;margin:0 auto}
  .qgrid.two{grid-template-columns:repeat(2,1fr);max-width:560px}
  .qgrid.four{grid-template-columns:repeat(4,1fr);max-width:820px}
  .qcard{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;padding:30px 20px;border:1px solid var(--line);border-radius:20px;
    background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.015));transition:transform .25s,border-color .25s,box-shadow .25s;text-align:center}
  .qcard:hover{transform:translateY(-4px);border-color:var(--line2);box-shadow:0 24px 50px -30px rgba(91,124,240,.6)}
  .qc-ic{font-size:2rem;line-height:1}
  .qc-t{font-family:var(--display);font-weight:600;font-size:1.1rem}
  .qc-d{color:var(--muted);font-size:.85rem}

  .nav-row{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:30px}
  .stepdots{display:flex;gap:7px}
  .stepdots i{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.18);transition:all .3s}
  .stepdots i.on{background:var(--sky);width:22px;border-radius:99px}
  .backbtn{font-family:var(--mono);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:99px;padding:8px 16px;transition:all .25s}
  .backbtn:hover{color:var(--text);border-color:var(--line2)}

  /* результат */
  .res-head{text-align:center;margin-bottom:6px}
  .res-tag{font-family:var(--mono);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--cyan);margin-bottom:12px}
  .res-title{font-family:var(--display);font-weight:700;font-size:clamp(1.7rem,3.6vw,2.4rem);letter-spacing:-.01em}
  .res-sub{color:var(--muted);margin:8px 0 34px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px;text-align:left}
  .card{position:relative;display:block;border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:20px 20px 18px;transition:transform .25s,border-color .25s,box-shadow .25s;color:inherit}
  .card:hover{transform:translateY(-3px);border-color:var(--line2);box-shadow:0 22px 44px -30px rgba(0,0,0,.8)}
  .card.feat{background:linear-gradient(150deg,rgba(91,124,240,.16),rgba(179,107,224,.10));border-color:rgba(91,124,240,.4)}
  .card .ic{font-size:1.5rem}
  .card h3{font-family:var(--display);font-weight:600;font-size:1.08rem;margin:12px 0 4px}
  .card p{color:var(--muted);font-size:.86rem;margin-bottom:12px}
  .card .go{font-family:var(--mono);font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;color:var(--sky)}
  .card .soon{font-family:var(--mono);font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:99px;padding:3px 9px}
  .res-actions{display:flex;justify-content:center;margin-top:34px}
  .restart{font-family:var(--display);font-weight:600;font-size:.9rem;border:1px solid var(--line2);border-radius:99px;padding:12px 24px;transition:all .25s}
  .restart:hover{background:rgba(255,255,255,.06)}

  footer{position:relative;z-index:5;border-top:1px solid var(--line);margin-top:60px;padding:30px 24px;text-align:center;color:var(--muted);font-family:var(--mono);font-size:.7rem;letter-spacing:.12em}

  @media (max-width:720px){
    .qgrid,.qgrid.four{grid-template-columns:1fr;max-width:420px}
    .qgrid.two{grid-template-columns:1fr;max-width:420px}
    .qcard{flex-direction:row;justify-content:flex-start;text-align:left;padding:18px 20px;gap:14px}
    .qc-ic{font-size:1.6rem}
    .bird{opacity:.05;width:70vw;top:8%}
  }
</style>
</head>
<body>
<div class="bgfx"></div>
<svg class="bird" viewBox="0 0 100 100" aria-hidden="true"><defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#06B6D4"/><stop offset=".5" stop-color="#5B7CF0"/><stop offset="1" stop-color="#FF8FA8"/></linearGradient></defs><path d="M50 30 C47 41,37 43,16 33 C33 44,46 48,50 70 C54 48,67 44,84 33 C63 43,53 41,50 30 Z"/></svg>

<nav>
  <a class="brand" href="/"><img src="/logo.png" alt="pichugster">pichugster</a>
  <div class="nav-right">Нячанг · Вьетнам</div>
</nav>

<main>
  <section class="hero">
    <span class="eyebrow">the sky has no borders</span>
    <h1>Скажи, кто ты — <span class="grad">соберём под тебя</span></h1>
    <p class="lede">Твой проводник по Нячангу и удалённой жизни. Ответь на пару вопросов — получи персональную подборку.</p>

    <div class="builder" id="builder">

      <!-- ШАГ 1 -->
      <div class="screen active" data-screen="who">
        <div class="qhead">Кто ты?</div>
        <div class="qsub">С этого и начнём — покажу то, что нужно именно тебе.</div>
        <div class="qgrid">
          <button class="qcard" data-field="who" data-val="tourist"><span class="qc-ic">🏖</span><span class="qc-t">Турист</span><span class="qc-d">Еду отдохнуть</span></button>
          <button class="qcard" data-field="who" data-val="move"><span class="qc-ic">✈️</span><span class="qc-t">Переезжаю</span><span class="qc-d">Хочу жить здесь</span></button>
          <button class="qcard" data-field="who" data-val="earn"><span class="qc-ic">💻</span><span class="qc-t">Удалёнка</span><span class="qc-d">Хочу зарабатывать</span></button>
        </div>
      </div>

      <!-- ТУРИСТ: опыт -->
      <div class="screen" data-screen="tourist-exp">
        <div class="qhead">Ты уже был в Нячанге?</div>
        <div class="qsub">Подберу подборку под твой опыт.</div>
        <div class="qgrid two">
          <button class="qcard" data-field="touristExp" data-val="first"><span class="qc-ic">🌟</span><span class="qc-t">Впервые</span><span class="qc-d">Расскажи главное</span></button>
          <button class="qcard" data-field="touristExp" data-val="been"><span class="qc-ic">🔁</span><span class="qc-t">Уже был</span><span class="qc-d">Хочу глубже</span></button>
        </div>
      </div>

      <!-- ПЕРЕЕЗД: доход -->
      <div class="screen" data-screen="move-income">
        <div class="qhead">С каким доходом переезжаешь?</div>
        <div class="qsub">Это главный вопрос — от него зависит план.</div>
        <div class="qgrid">
          <button class="qcard" data-field="income" data-val="income"><span class="qc-ic">💼</span><span class="qc-t">С доходом</span><span class="qc-d">Есть удалённая работа</span></button>
          <button class="qcard" data-field="income" data-val="savings"><span class="qc-ic">💰</span><span class="qc-t">С накоплениями</span><span class="qc-d">На время хватит</span></button>
          <button class="qcard" data-field="income" data-val="none"><span class="qc-ic">🧑‍💻</span><span class="qc-t">Без дохода</span><span class="qc-d">Надо научиться</span></button>
        </div>
      </div>

      <!-- ПЕРЕЕЗД: состав -->
      <div class="screen" data-screen="move-company">
        <div class="qhead">С кем едешь?</div>
        <div class="qsub">У каждого состава свои заботы — учту.</div>
        <div class="qgrid four">
          <button class="qcard" data-field="company" data-val="solo"><span class="qc-ic">🧍</span><span class="qc-t">Один</span></button>
          <button class="qcard" data-field="company" data-val="couple"><span class="qc-ic">👫</span><span class="qc-t">Пара</span></button>
          <button class="qcard" data-field="company" data-val="family"><span class="qc-ic">👨‍👩‍👧</span><span class="qc-t">С детьми</span></button>
          <button class="qcard" data-field="company" data-val="pet"><span class="qc-ic">🐾</span><span class="qc-t">С питомцем</span></button>
        </div>
      </div>

      <!-- РЕЗУЛЬТАТ -->
      <div class="screen" data-screen="result">
        <div class="res-head">
          <div class="res-tag" id="res-tag">Твоя подборка</div>
          <div class="res-title" id="res-title"></div>
          <div class="res-sub" id="res-sub"></div>
        </div>
        <div class="cards" id="res-cards"></div>
        <div class="res-actions"><button class="restart" id="restart">← Собрать заново</button></div>
      </div>

      <div class="nav-row">
        <button class="backbtn" id="backbtn" style="visibility:hidden">← Назад</button>
        <div class="stepdots" id="dots"><i class="on"></i><i></i><i></i></div>
      </div>
    </div>
  </section>
</main>

<footer>© 2026 pichugster · the sky has no borders</footer>

<script is:inline>
  const state = { who:null, touristExp:null, income:null, company:null };
  const history = [];
  const screens = {};
  document.querySelectorAll('.screen').forEach(s => screens[s.dataset.screen] = s);
  const backBtn = document.getElementById('backbtn');
  const dots = document.getElementById('dots');

  function depthFor(name){
    if(name==='who') return 1;
    if(name==='tourist-exp'||name==='move-income') return 2;
    if(name==='move-company') return 3;
    return 4;
  }
  function totalFor(){
    if(state.who==='earn') return 1;
    if(state.who==='tourist') return 2;
    if(state.who==='move') return 3;
    return 3;
  }
  function renderDots(name){
    const total = name==='who' ? 3 : totalFor();
    const cur = Math.min(depthFor(name), total);
    dots.innerHTML='';
    for(let i=1;i<=total;i++){ const el=document.createElement('i'); if(i<=cur) el.className='on'; dots.appendChild(el); }
    dots.style.visibility = name==='result' ? 'hidden' : 'visible';
  }
  function show(name){
    Object.values(screens).forEach(s=>s.classList.remove('active'));
    screens[name].classList.add('active');
    backBtn.style.visibility = history.length ? 'visible' : 'hidden';
    renderDots(name);
    window.scrollTo({top:0,behavior:'smooth'});
  }
  function nextScreen(cur){
    if(cur==='who') return state.who==='tourist' ? 'tourist-exp' : state.who==='move' ? 'move-income' : 'result';
    if(cur==='tourist-exp') return 'result';
    if(cur==='move-income') return 'move-company';
    if(cur==='move-company') return 'result';
    return 'result';
  }

  document.querySelectorAll('.qcard').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const cur = btn.closest('.screen').dataset.screen;
      state[btn.dataset.field] = btn.dataset.val;
      const nxt = nextScreen(cur);
      history.push(cur);
      if(nxt==='result') buildResult();
      show(nxt);
    });
  });
  backBtn.addEventListener('click',()=>{
    const prev = history.pop();
    if(prev) show(prev);
  });
  document.getElementById('restart').addEventListener('click',()=>{
    state.who=state.touristExp=state.income=state.company=null;
    history.length=0; show('who');
  });

  function card(ic,t,d,href){
    if(href) return `<a class="card" href="${href}"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="go">Открыть →</span></a>`;
    return `<div class="card"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="soon">Скоро</span></div>`;
  }
  function buildResult(){
    let title='', sub='', cards=[];
    if(state.who==='tourist'){
      title = state.touristExp==='first' ? 'Впервые в Нячанге' : 'Возвращаешься в Нячанг';
      sub = 'Подборка для отдыха — проверено на месте';
      cards = [
        card('🍜','Где поесть','Кафе, стритфуд, рестораны'),
        card('🏖','Пляжные клубы','Где провести день у моря'),
        card('💆','Массажи и спа','Проверенные места'),
        card('🎉','Тусовки','Бары и вечеринки'),
        card('🗺','Экскурсии','Острова, водопады, туры'),
        card('🛵','Аренда байка','Где брать и как не влететь'),
        card('🏨','Где остановиться','Районы и отели'),
        card('💸','Цены','Сколько брать с собой'),
      ];
    } else if(state.who==='move'){
      const inc = {income:'С доходом',savings:'С накоплениями',none:'Без дохода'}[state.income]||'';
      const comp = {solo:'один',couple:'парой',family:'с детьми',pet:'с питомцем'}[state.company]||'';
      title = 'Переезд в Нячанг';
      sub = [inc, comp].filter(Boolean).join(' · ');
      if(state.income==='none') cards.push(card('🧑‍💻','Научиться зарабатывать','Удалённый доход с нуля — с чего начать','/zarabotok').replace('class="card"','class="card feat"'));
      cards.push(
        card('🛂','Виза','Как въехать и продлевать'),
        card('🏠','Жильё надолго','Районы, цены, договоры'),
        card('🏦','Банки и деньги','Карты и как платить'),
        card('📶','Симка и интернет','Связь с первого дня'),
        card('🛵','Транспорт','Байк, права, аренда'),
        card('🩺','Медицина','Клиники и страховка'),
        card('💸','Сколько нужно денег','Стартовый бюджет'),
        card('🤝','Комьюнити','Где найти своих'),
      );
      if(state.company==='family') cards.push(card('🎒','Школы и садики','Куда устроить детей'));
      if(state.company==='pet') cards.push(card('🐾','Ввоз питомца','Документы и жильё'));
    } else {
      title = 'Удалённый доход';
      sub = 'С чего начать зарабатывать из любой точки';
      cards = [
        card('🤖','Заработок на ИИ','Услуги, контент, продукты','/zarabotok'),
        card('🎬','Монтаж Reels','Навык, который кормит','/montazh'),
        card('🛍','Маркетплейсы','Карточки и SEO','/zarabotok/marketplaces'),
        card('✍️','Контент и тексты','На заказ и для себя','/zarabotok/content-marketing'),
        card('🧭','С чего начать','Первые шаги новичку'),
      ];
    }
    document.getElementById('res-title').textContent = title;
    document.getElementById('res-sub').textContent = sub;
    document.getElementById('res-cards').innerHTML = cards.join('');
  }
</script>
</body>
</html>
