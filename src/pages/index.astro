---
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>pichugster — твой гид по Вьетнаму и удалённой жизни</title>
<meta name="description" content="Портал-проводник по Нячангу и удалённой жизни. Выбери, кто ты — получи подборку под себя: еда, пляжи, виза, жильё, заработок.">
<meta name="theme-color" content="#FFFCF9">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#FFFCF9; --ink:#141A2A; --muted:#6B7382; --line:#EFE7DF; --surface:#ffffff;
    --sky:#2563EB; --coral:#FF7E6B; --amber:#FF9E64; --pink:#FB7BA2; --cyan:#06B6D4; --violet:#8B5CF6;
    --sun:linear-gradient(120deg,#FFB25E 0%,#FF7E6B 55%,#FB7BA2 100%);
    --grad:linear-gradient(120deg,#06B6D4 0%,#5B7CF0 42%,#B36BE0 72%,#FF8FA8 100%);
    --display:"Quicksand",system-ui,sans-serif; --body:"Inter",system-ui,sans-serif; --maxw:1120px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--ink);font-family:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  ::selection{background:var(--coral);color:#fff}
  a{color:inherit;text-decoration:none}
  button,select{font:inherit;color:inherit}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 22px}
  .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  :focus-visible{outline:2px solid var(--sky);outline-offset:2px;border-radius:8px}

  .sky-glow{position:fixed;inset:0;z-index:0;pointer-events:none;
    background:radial-gradient(75% 55% at 50% -12%,rgba(255,175,120,.30),transparent 62%),
      radial-gradient(45% 40% at 88% 2%,rgba(179,107,224,.14),transparent 60%),
      radial-gradient(50% 40% at 6% 6%,rgba(6,182,212,.10),transparent 60%)}

  nav{position:relative;z-index:10;display:flex;align-items:center;justify-content:space-between;padding:18px 22px;max-width:var(--maxw);margin:0 auto}
  .brand{display:flex;align-items:center;gap:9px;font-family:var(--display);font-weight:700;font-size:1.15rem}
  .brand img{height:30px}
  .nav-right{font-family:ui-monospace,monospace;font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}

  main{position:relative;z-index:5}
  .hero{max-width:var(--maxw);margin:0 auto;padding:clamp(20px,5vh,54px) 22px 20px;text-align:center}
  .eyebrow{font-family:ui-monospace,monospace;font-size:.72rem;letter-spacing:.28em;text-transform:uppercase;color:var(--coral)}
  .hero h1{font-family:var(--display);font-weight:700;font-size:clamp(2rem,5vw,3.4rem);line-height:1.05;letter-spacing:-.02em;margin:16px auto 12px;max-width:18ch}
  .hero .lede{color:var(--muted);font-size:clamp(1rem,1.5vw,1.12rem);max-width:44ch;margin:0 auto}

  /* ВИДЖЕТ как у Aviasales */
  .search{max-width:940px;margin:34px auto 0}
  .tabs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:16px}
  .tab{display:inline-flex;align-items:center;gap:8px;padding:11px 20px;border-radius:999px;border:1px solid var(--line);background:#fff;font-family:var(--display);font-weight:600;font-size:.95rem;color:var(--muted);cursor:pointer;transition:all .22s;box-shadow:0 6px 18px -14px rgba(20,26,42,.4)}
  .tab:hover{color:var(--ink)}
  .tab.active{color:#fff;background:var(--sun);border-color:transparent;box-shadow:0 14px 30px -14px rgba(255,126,107,.7)}

  .widget{display:flex;align-items:stretch;gap:0;background:#fff;border:1px solid var(--line);border-radius:22px;padding:8px;box-shadow:0 30px 60px -34px rgba(20,26,42,.4);flex-wrap:wrap}
  .fields{display:flex;flex:1;min-width:0}
  .fields[hidden]{display:none}
  .field{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px;padding:10px 18px;position:relative;text-align:left}
  .field + .field{border-left:1px solid var(--line)}
  .field label{font-size:.68rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
  .field .selwrap{position:relative}
  .field select{appearance:none;-webkit-appearance:none;width:100%;border:0;background:none;font-family:var(--display);font-weight:600;font-size:1rem;color:var(--ink);padding:2px 20px 2px 0;cursor:pointer;outline:none}
  .field .selwrap::after{content:"▾";position:absolute;right:0;top:50%;transform:translateY(-50%);color:var(--muted);font-size:.8rem;pointer-events:none}
  .field.static b{font-family:var(--display);font-weight:600;font-size:1rem;padding-top:2px}
  .wbtn{flex:none;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:16px;background:var(--sun);color:#fff;font-family:var(--display);font-weight:700;font-size:1rem;padding:0 26px;margin:2px;cursor:pointer;transition:transform .2s,box-shadow .2s;box-shadow:0 14px 30px -12px rgba(255,126,107,.75)}
  .wbtn:hover{transform:translateY(-2px)}

  /* ПОДБОРКИ */
  .picks{position:relative;z-index:5;padding:56px 0 40px}
  .picks-head{text-align:center;margin-bottom:30px}
  .picks-head h2{font-family:var(--display);font-weight:700;font-size:clamp(1.5rem,3vw,2.1rem);letter-spacing:-.01em}
  .picks-head p{color:var(--muted);margin-top:6px}
  .cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:14px}
  .card{position:relative;display:block;background:#fff;border:1px solid var(--line);border-radius:18px;padding:20px;transition:transform .25s,box-shadow .25s,border-color .25s;color:inherit;box-shadow:0 12px 30px -24px rgba(20,26,42,.5)}
  .card:hover{transform:translateY(-4px);border-color:#f3d9c9;box-shadow:0 26px 46px -28px rgba(255,126,107,.5)}
  .card.feat{background:linear-gradient(150deg,rgba(255,158,100,.16),rgba(251,123,162,.12));border-color:#f6cbb3}
  .card .ic{font-size:1.6rem}
  .card h3{font-family:var(--display);font-weight:600;font-size:1.08rem;margin:12px 0 4px}
  .card p{color:var(--muted);font-size:.86rem;margin-bottom:12px}
  .card .go{font-family:ui-monospace,monospace;font-size:.64rem;letter-spacing:.1em;text-transform:uppercase;color:var(--coral);font-weight:700}
  .card .soon{font-family:ui-monospace,monospace;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:99px;padding:3px 9px}

  footer{position:relative;z-index:5;border-top:1px solid var(--line);margin-top:40px;padding:30px 22px;text-align:center;color:var(--muted);font-family:ui-monospace,monospace;font-size:.7rem;letter-spacing:.1em}

  @media (max-width:760px){
    .widget{flex-direction:column;padding:10px;border-radius:20px}
    .fields{flex-direction:column}
    .field + .field{border-left:0;border-top:1px solid var(--line)}
    .wbtn{padding:16px;margin-top:6px;width:100%}
  }
</style>
</head>
<body>
<div class="sky-glow"></div>

<nav>
  <a class="brand" href="/"><img src="/logo.png" alt="pichugster">pichugster</a>
  <div class="nav-right">Нячанг · Вьетнам</div>
</nav>

<main>
  <section class="hero">
    <span class="eyebrow">the sky has no borders</span>
    <h1>Твой гид по Вьетнаму <span class="grad">и удалённой жизни</span></h1>
    <p class="lede">Выбери, кто ты — соберём подборку из проверенного на месте. Или тыкай прямо в категории ниже.</p>

    <div class="search">
      <div class="tabs">
        <button class="tab active" data-tab="tourist">🏖 Туристу</button>
        <button class="tab" data-tab="move">✈️ Переезд</button>
        <button class="tab" data-tab="earn">💻 Удалёнка</button>
      </div>

      <div class="widget">
        <!-- ТУРИСТ -->
        <div class="fields" data-fields="tourist">
          <div class="field"><label>Ты в Нячанге</label><div class="selwrap"><select id="t_exp"><option value="first">Впервые</option><option value="been">Уже был</option></select></div></div>
          <div class="field"><label>Что интересно</label><div class="selwrap"><select id="t_int"><option value="all">Всё подряд</option><option value="food">Где поесть</option><option value="beach">Пляжи</option><option value="party">Тусовки</option><option value="tours">Экскурсии</option></select></div></div>
          <div class="field static"><label>Город</label><b>Нячанг</b></div>
        </div>
        <!-- ПЕРЕЕЗД -->
        <div class="fields" data-fields="move" hidden>
          <div class="field"><label>Едешь</label><div class="selwrap"><select id="m_inc"><option value="income">С доходом</option><option value="savings">С накоплениями</option><option value="none">Без дохода</option></select></div></div>
          <div class="field"><label>Состав</label><div class="selwrap"><select id="m_comp"><option value="solo">Один</option><option value="couple">Парой</option><option value="family">С детьми</option><option value="pet">С питомцем</option></select></div></div>
          <div class="field static"><label>Город</label><b>Нячанг</b></div>
        </div>
        <!-- УДАЛЁНКА -->
        <div class="fields" data-fields="earn" hidden>
          <div class="field"><label>Направление</label><div class="selwrap"><select id="e_dir"><option value="all">Все способы</option><option value="ai">Нейросети</option><option value="montage">Монтаж</option><option value="content">Контент</option><option value="mp">Маркетплейсы</option></select></div></div>
          <div class="field"><label>Уровень</label><div class="selwrap"><select id="e_lvl"><option value="zero">С нуля</option><option value="some">Уже что-то умею</option></select></div></div>
        </div>
        <button class="wbtn" id="go">Показать подборку</button>
      </div>
    </div>
  </section>

  <section class="picks" id="picks">
    <div class="wrap">
      <div class="picks-head">
        <h2 id="picksTitle">Подборки для туриста</h2>
        <p id="picksSub">Проверено на месте — тыкай в категорию</p>
      </div>
      <div class="cards" id="cards"></div>
    </div>
  </section>
</main>

<footer>© 2026 pichugster · the sky has no borders</footer>

<script is:inline>
  let activeTab = 'tourist';
  const tabs = document.querySelectorAll('.tab');
  const fieldsets = document.querySelectorAll('.fields');
  const cardsEl = document.getElementById('cards');
  const titleEl = document.getElementById('picksTitle');
  const subEl = document.getElementById('picksSub');

  function card(ic,t,d,href){
    if(href) return `<a class="card" href="${href}"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="go">Открыть →</span></a>`;
    return `<div class="card"><div class="ic">${ic}</div><h3>${t}</h3><p>${d}</p><span class="soon">Скоро</span></div>`;
  }
  function val(id,def){ const el=document.getElementById(id); return el?el.value:def; }

  function render(){
    let title='', sub='', cards=[];
    if(activeTab==='tourist'){
      title='Подборки для туриста';
      sub = val('t_exp','first')==='first' ? 'Впервые в Нячанге — вот с чего начать' : 'Ты уже был — копнём глубже';
      cards=[
        card('🍜','Где поесть','Кафе, стритфуд, рестораны'),
        card('🏖','Пляжные клубы','Где провести день у моря'),
        card('💆','Массажи и спа','Проверенные места'),
        card('🎉','Тусовки','Бары и вечеринки'),
        card('🗺','Экскурсии','Острова, водопады, туры'),
        card('🛵','Аренда байка','Где брать и как не влететь'),
        card('🏨','Где остановиться','Районы и отели'),
        card('💸','Цены','Сколько брать с собой'),
      ];
    } else if(activeTab==='move'){
      const inc={income:'С доходом',savings:'С накоплениями',none:'Без дохода'}[val('m_inc','income')];
      const comp={solo:'один',couple:'парой',family:'с детьми',pet:'с питомцем'}[val('m_comp','solo')];
      title='Переезд в Нячанг';
      sub=inc+' · '+comp;
      if(val('m_inc','income')==='none') cards.push(card('🧑‍💻','Научиться зарабатывать','Удалённый доход с нуля','/zarabotok').replace('class="card"','class="card feat"'));
      cards.push(
        card('🛂','Виза','Как въехать и продлевать'),
        card('🏠','Жильё надолго','Районы, цены, договоры'),
        card('🏦','Банки и деньги','Карты и как платить'),
        card('📶','Симка и интернет','Связь с первого дня'),
        card('🛵','Транспорт','Байк, права, аренда'),
        card('🩺','Медицина','Клиники и страховка'),
        card('💸','Сколько нужно денег','Стартовый бюджет'),
        card('🤝','Комьюнити','Где найти своих'),
      );
      if(val('m_comp','solo')==='family') cards.push(card('🎒','Школы и садики','Куда устроить детей'));
      if(val('m_comp','solo')==='pet') cards.push(card('🐾','Ввоз питомца','Документы и жильё'));
    } else {
      title='Удалённый доход';
      sub=val('e_lvl','zero')==='zero'?'С нуля — старт для новичка':'Уже умеешь — прокачаем';
      cards=[
        card('🤖','Заработок на ИИ','Услуги, контент, продукты','/zarabotok'),
        card('🎬','Монтаж Reels','Навык, который кормит','/montazh'),
        card('🛍','Маркетплейсы','Карточки и SEO','/zarabotok/marketplaces'),
        card('✍️','Контент и тексты','На заказ и для себя','/zarabotok/content-marketing'),
        card('🧭','С чего начать','Первые шаги новичку'),
      ];
    }
    titleEl.textContent=title; subEl.textContent=sub; cardsEl.innerHTML=cards.join('');
  }

  tabs.forEach(t=>t.addEventListener('click',()=>{
    tabs.forEach(x=>x.classList.remove('active')); t.classList.add('active');
    activeTab=t.dataset.tab;
    fieldsets.forEach(f=>f.hidden = f.dataset.fields!==activeTab);
    render();
  }));
  document.querySelectorAll('.field select').forEach(s=>s.addEventListener('change',render));
  document.getElementById('go').addEventListener('click',()=>{
    render();
    document.getElementById('picks').scrollIntoView({behavior:'smooth',block:'start'});
  });
  render();
</script>
</body>
</html>
