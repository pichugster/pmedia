<script>
  document.querySelector('.burger').addEventListener('click',function(){
    var l=document.querySelector('.nav-links');
    var open=l.style.display==='flex';
    l.style.display=open?'none':'flex';
    if(!open){Object.assign(l.style,{position:'absolute',top:'56px',left:'0',right:'0',flexDirection:'column',gap:'0',background:'#fff',borderBottom:'1px solid var(--line)',padding:'8px 0'});
