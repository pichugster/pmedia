<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>pichugster — монтаж Reels с нейросетями</title>
<meta name="description" content="Монтаж Reels и Shorts с нейросетями. Динамика, субтитры, цвет — ролики, которые останавливают скролл. Закажите под ключ или научитесь сами.">
<link rel="icon" href="/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style is:global>
  :root{
    --bg:#0A0E1A; --bg2:#0E1528; --surface:#121B30; --surface2:#0F1729;
    --line:rgba(255,255,255,.08); --line2:rgba(255,255,255,.14);
    --text:#E9EEF9; --muted:#8A97B0; --sky:#5B8CFF; --cyan:#06B6D4;
    --grad:linear-gradient(120deg,#06B6D4 0%,#5B7CF0 42%,#B36BE0 72%,#FF8FA8 100%);
    --display:"Quicksand",system-ui,sans-serif; --body:"Inter",system-ui,sans-serif;
    --mono:ui-monospace,SFMono-Regular,Menlo,monospace; --maxw:1160px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{background:var(--bg);color:var(--text);font-family:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  ::selection{background:#5B7CF0;color:#fff}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 28px}
  :focus-visible{outline:2px solid var(--sky);outline-offset:3px;border-radius:6px}
  .eyebrow{font-family:var(--mono);font-size:.72rem;font-weight:500;letter-spacing:.32em;text-transform:uppercase;color:var(--sky)}
  .sec-label{font-family:var(--mono);font-size:.72rem;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--sky);margin-bottom:12px}
  .sec-title{font-family:var(--display);font-weight:700;font-size:clamp(1.7rem,3.6vw,2.7rem);line-height:1.08;letter-spacing:-.015em}
  .sec-intro{color:var(--muted);max-width:56ch;margin-top:12px;font-size:1.05rem}
  .grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .band{padding:96px 0}

  .btn{font-family:var(--display);font-weight:600;font-size:.95rem;padding:14px 26px;border-radius:999px;display:inline-flex;align-items:center;gap:.5em;transition:transform .25s,box-shadow .3s,background .3s;cursor:pointer;border:0}
  .btn-primary{background:var(--sky);color:#fff;box-shadow:0 10px 30px -10px rgba(91,140,255,.6)}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 16px 40px -10px rgba(91,140,255,.8)}
  .btn-ghost{border:1px solid var(--line2);color:var(--text);background:rgba(255,255,255,.04)}
  .btn-ghost:hover{transform:translateY(-2px);border-color:var(--sky);background:rgba(91,140,255,.1)}
  .cta-row{display:flex;flex-wrap:wrap;gap:14px}

  /* NAV */
  nav{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 28px;background:rgba(10,14,26,.72);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
  .brand{display:flex;align-items:center;gap:10px}
  .brand img{height:32px;width:auto}
  .brand b{font-family:var(--display);font-weight:700;font-size:1.12rem;letter-spacing:-.01em}
  .nav-links{display:flex;gap:20px;font-size:.9rem;color:var(--muted)}
  .nav-links a:hover{color:var(--text)}
  .nav-cta{font-family:var(--display);font-weight:600;font-size:.85rem;background:var(--sky);color:#fff;padding:9px 18px;border-radius:999px;box-shadow:0 8px 22px -8px rgba(91,140,255,.7)}
  .burger{display:none;background:none;border:0;font-size:1.4rem;cursor:pointer;color:var(--text)}

  /* HERO */
  .hero{position:relative;overflow:hidden;padding:96px 0 80px;text-align:center;
    background:
      radial-gradient(60% 60% at 50% 0%,rgba(91,124,240,.18),transparent 70%),
      linear-gradient(rgba(255,255,255,.025) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px),
      var(--bg);
    background-size:auto,46px 46px,46px 46px,auto}
  .hero .eyebrow{display:inline-flex;gap:.7em;align-items:center}
  .hero h1{font-family:var(--display);font-weight:700;font-size:clamp(2.4rem,6.4vw,4.6rem);line-height:1.02;letter-spacing:-.025em;max-width:16ch;margin:22px auto 22px}
  .hero p.lede{font-size:clamp(1.05rem,1.7vw,1.25rem);color:var(--muted);max-width:52ch;margin:0 auto 30px}
  .hero .cta-row{justify-content:center;margin-bottom:56px}

  .timeline{max-width:820px;margin:0 auto;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg,rgba(255,255,255,.04),rgba(255,255,255,.01));padding:18px 20px;text-align:left}
  .tl-label{font-family:var(--mono);font-size:.68rem;letter-spacing:.18em;color:var(--muted);margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .tl-dot{width:8px;height:8px;border-radius:50%;background:var(--sky);box-shadow:0 0 10px var(--sky)}
  .tl-tracks{display:flex;flex-direction:column;gap:9px}
  .tl-row{display:flex;gap:8px}
  .tl-row span{height:16px;border-radius:5px;background:var(--grad);opacity:.85}
  .tl-row:nth-child(2) span{opacity:.6}
  .tl-row:nth-child(3) span{opacity:.4}
  .scroll-cue{font-family:var(--mono);font-size:.64rem;letter-spacing:.24em;color:var(--muted);text-transform:uppercase;margin-top:26px;display:inline-block;animation:cue 2s ease-in-out infinite}
  @keyframes cue{0%,100%{opacity:.4;transform:translateY(0)}50%{opacity:1;transform:translateY(4px)}}

  /* WORKS */
  .works{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
  .work{border:1px solid var(--line);border-radius:18px;background:var(--surface);overflow:hidden;transition:transform .3s,border-color .3s,box-shadow .3s}
  .work:hover{transform:translateY(-4px);border-color:var(--line2);box-shadow:0 26px 50px -30px rgba(0,0,0,.7)}
  .work-media{position:relative;aspect-ratio:9/11;background:
    radial-gradient(120% 80% at 50% 0%,rgba(91,124,240,.35),transparent 60%),
    linear-gradient(160deg,#152036,#0d1526);display:flex;align-items:center;justify-content:center}
  .work-media .play{width:56px;height:56px;border-radius:50%;background:rgba(255,255,255,.1);border:1px solid var(--line2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;color:#fff}
  .work-body{padding:20px}
  .tier{font-family:var(--mono);font-size:.62rem;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);border:1px solid rgba(6,182,212,.4);border-radius:999px;padding:3px 10px}
  .work-body h3{font-family:var(--display);font-weight:600;font-size:1.2rem;margin:12px 0 6px}
  .work-body>p{color:var(--muted);font-size:.92rem;margin-bottom:14px}
  .tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:16px}
  .tags span{font-size:.72rem;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:3px 8px}
  .work-foot{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:14px}
  .wprice{font-family:var(--display);font-weight:700;font-size:1.15rem}
  .wlink{font-family:var(--mono);font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:rgba(255,255,255,.08);border:1px solid var(--line2);border-radius:999px;padding:5px 12px}

  /* BENEFITS */
  .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}
  .card{border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:26px 24px}
  .card .ic{font-size:1.6rem}
  .card h3{font-family:var(--display);font-weight:600;font-size:1.12rem;margin:14px 0 6px}
  .card p{color:var(--muted);font-size:.93rem}

  /* PROCESS */
  .steps{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:44px;counter-reset:st}
  .step{border:1px solid var(--line);border-radius:16px;background:var(--surface);padding:22px 18px;position:relative}
  .step .n{font-family:var(--mono);font-size:.72rem;letter-spacing:.14em;color:var(--sky)}
  .step h3{font-family:var(--display);font-weight:600;font-size:1rem;margin:10px 0 6px}
  .step p{color:var(--muted);font-size:.86rem}

  /* CTA / FORM */
  .cta-final{position:relative;overflow:hidden;border-radius:26px;border:1px solid var(--line);
    background:radial-gradient(80% 120% at 50% 0%,rgba(91,124,240,.22),transparent 62%),var(--bg2);padding:60px 40px;text-align:center}
  .cta-final h2{font-family:var(--display);font-weight:700;font-size:clamp(1.8rem,3.6vw,2.8rem);line-height:1.08;letter-spacing:-.015em;max-width:20ch;margin:0 auto 12px}
  .cta-final p{color:var(--muted);max-width:48ch;margin:0 auto 26px}
  .hp-form{display:flex;flex-direction:column;gap:12px;max-width:500px;margin:0 auto}
  .hp-form input,.hp-form textarea{width:100%;padding:14px 16px;border:1px solid var(--line2);border-radius:12px;font-family:var(--body);font-size:1rem;background:var(--surface2);color:var(--text);resize:vertical}
  .hp-form input::placeholder,.hp-form textarea::placeholder{color:#6b7794}
  .hp-form input:focus,.hp-form textarea:focus{outline:none;border-color:var(--sky);box-shadow:0 0 0 3px rgba(91,140,255,.18)}
  .hp-form .btn{align-self:center}
  .hp-status{min-height:1.2em;font-size:.94rem}
  .hp-status.ok{color:#4ADE80}.hp-status.err{color:#F87171}
  .or{color:var(--muted);font-size:.85rem;margin:18px 0 10px}

  footer{border-top:1px solid var(--line);padding:40px 0;margin-top:20px}
  footer .wrap{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center}
  footer b{font-family:var(--display);font-weight:700;color:#fff;font-size:1.05rem}
  footer .links{display:flex;gap:18px;flex-wrap:wrap;font-size:.9rem;color:var(--muted)}
  footer .links a:hover{color:var(--text)}
  footer .meta{font-family:var(--mono);font-size:.7rem;color:var(--muted);width:100%;border-top:1px solid var(--line);padding-top:16px}

  @media (max-width:900px){.nav-links{display:none}.burger{display:block}
    .works,.grid3{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:560px){.works,.grid3,.steps{grid-template-columns:1fr}.band{padding:64px 0}.wrap{padding:0 20px}
    .cta-final{padding:44px 22px}}
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto}}
</style>
</head>
<body>

<nav>
  <a class="brand" href="/"><img src="/logo.png" alt="pichugster"><b>pichugster</b></a>
  <div class="nav-links">
    <a href="#portfolio">Портфолио</a><a href="#benefits">Преимущества</a><a href="#process">Процесс</a><a href="/montazh">Все форматы</a><a href="/uslugi">Услуги</a><a href="/zarabotok">Обучение</a>
  </div>
  <a class="nav-cta" href="#order">Заказать монтаж</a>
  <button class="burger" aria-label="Меню">☰</button>
</nav>

<!-- HERO -->
<header class="hero">
  <div class="wrap">
    <span class="eyebrow">Видеомонтаж · Reels · Нейросети</span>
    <h1>Монтаж Reels, который <span class="grad">останавливает скролл</span></h1>
    <p class="lede">Делаем динамичные ролики с нейросетями — ритм, субтитры и цвет работают на вашу аудиторию. Закажите под ключ или научитесь монтировать сами.</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#portfolio">▶ Смотреть работы</a>
      <a class="btn btn-ghost" href="#order">Обсудить проект ↗</a>
    </div>
    <div class="timeline">
      <div class="tl-label"><span class="tl-dot"></span>TIMELINE · PICHUGSTER_REEL_2026</div>
      <div class="tl-tracks">
        <div class="tl-row"><span style="width:22%"></span><span style="width:13%"></span><span style="width:31%"></span><span style="width:26%"></span></div>
        <div class="tl-row"><span style="width:16%"></span><span style="width:34%"></span><span style="width:19%"></span><span style="width:23%"></span></div>
        <div class="tl-row"><span style="width:28%"></span><span style="width:17%"></span><span style="width:25%"></span><span style="width:22%"></span></div>
      </div>
    </div>
    <span class="scroll-cue">Скролл ↓</span>
  </div>
</header>

<!-- ПОРТФОЛИО -->
<section class="band" id="portfolio">
  <div class="wrap">
    <div class="sec-label">Портфолио</div>
    <h2 class="sec-title">Избранные работы</h2>
    <p class="sec-intro">Каждый ролик — это работа с ритмом, динамикой кадра и атмосферой. Реальные примеры добавим здесь скоро.</p>
    <div class="works">
      <article class="work">
        <div class="work-media"><span class="play">▶</span></div>
        <div class="work-body">
          <span class="tier">Premium</span>
          <h3>Reels с AI-эффектами</h3>
          <p>AI-переходы и оживление фото, динамика под ритм — эффект погружения с первого кадра.</p>
          <div class="tags"><span>AI-эффекты</span><span>Motion</span><span>Субтитры</span></div>
          <div class="work-foot"><span class="wprice">от 2 000 ₽</span><span class="wlink">Скоро</span></div>
        </div>
      </article>
      <article class="work">
        <div class="work-media"><span class="play">▶</span></div>
        <div class="work-body">
          <span class="tier">Standart</span>
          <h3>Reels для эксперта</h3>
          <p>Говорящая голова, субтитры и акценты. Динамичная нарезка, которая удерживает до конца.</p>
          <div class="tags"><span>Экспертный</span><span>Субтитры</span><span>Reels</span></div>
          <div class="work-foot"><span class="wprice">от 1 500 ₽</span><span class="wlink">Скоро</span></div>
        </div>
      </article>
      <article class="work">
        <div class="work-media"><span class="play">▶</span></div>
        <div class="work-body">
          <span class="tier">Кейс</span>
          <h3>Было / стало</h3>
          <p>Показываем сырой материал и результат — нагляднее всего доказывает уровень монтажа.</p>
          <div class="tags"><span>До / после</span><span>Color</span><span>Ритм</span></div>
          <div class="work-foot"><span class="wprice">от 1 000 ₽</span><span class="wlink">Скоро</span></div>
        </div>
      </article>
    </div>
    <div style="margin-top:26px"><a class="btn btn-ghost" href="/montazh">Всё портфолио и форматы →</a></div>
  </div>
</section>

<!-- ПРЕИМУЩЕСТВА -->
<section class="band" id="benefits" style="padding-top:0">
  <div class="wrap">
    <div class="sec-label">Преимущества</div>
    <h2 class="sec-title">Почему выбирают нас</h2>
    <div class="grid3">
      <div class="card"><div class="ic">🎬</div><h3>Удержание внимания</h3><p>Каждая секунда работает на зрителя. Никаких провисаний — только динамика.</p></div>
      <div class="card"><div class="ic">🤖</div><h3>Монтаж с нейросетями</h3><p>AI ускоряет и усиливает: субтитры, нарезка, переходы, эффекты.</p></div>
      <div class="card"><div class="ic">✨</div><h3>Цвет и звук</h3><p>Кинематографическая обработка — ролик выглядит дороже с первого кадра.</p></div>
      <div class="card"><div class="ic">⚡</div><h3>Быстрые сроки</h3><p>Не заставляем ждать неделями. Чёткие дедлайны, прозрачный процесс.</p></div>
      <div class="card"><div class="ic">🔄</div><h3>Правки включены</h3><p>Дорабатываем до вашего одобрения — без скрытых доплат за итерации.</p></div>
      <div class="card"><div class="ic">🎯</div><h3>Два пути</h3><p>Сделаем за вас — или научим монтировать самому по гайдам.</p></div>
    </div>
  </div>
</section>

<!-- ПРОЦЕСС -->
<section class="band" id="process" style="padding-top:0">
  <div class="wrap">
    <div class="sec-label">Как мы работаем</div>
    <h2 class="sec-title">От идеи до готового ролика</h2>
    <div class="steps">
      <div class="step"><div class="n">01</div><h3>Материалы</h3><p>Присылаете исходники, референсы и пожелания.</p></div>
      <div class="step"><div class="n">02</div><h3>Бриф</h3><p>Уточняем цель, аудиторию, стиль и настроение.</p></div>
      <div class="step"><div class="n">03</div><h3>Монтаж</h3><p>Структура, ритм, музыка, эффекты и цвет — с ИИ.</p></div>
      <div class="step"><div class="n">04</div><h3>Правки</h3><p>Вносим корректировки до полного соответствия.</p></div>
      <div class="step"><div class="n">05</div><h3>Сдача</h3><p>Финальный ролик в нужных форматах и качестве.</p></div>
    </div>
  </div>
</section>

<!-- ФИНАЛ / ЗАЯВКА -->
<section class="band" id="order" style="padding-top:0">
  <div class="wrap">
    <div class="cta-final">
      <div class="sec-label" style="color:var(--cyan)">Готовы начать?</div>
      <h2>Ваш следующий ролик будет <span class="grad">лучшим в ленте</span></h2>
      <p>Оставьте заявку — ответим и обсудим проект. Или напишите нам напрямую в Telegram.</p>
      <form id="order-form" action="https://formspree.io/f/REPLACE_ME" method="POST" class="hp-form">
        <input type="hidden" name="_subject" value="Новая заявка на монтаж — главная">
        <input type="text" name="name" placeholder="Как вас зовут" required>
        <input type="text" name="contact" placeholder="Telegram или почта для связи" required>
        <textarea name="message" rows="4" placeholder="Что нужно смонтировать? Ссылка на материал, если есть." required></textarea>
        <button type="submit" class="btn btn-primary">Отправить заявку</button>
        <p id="order-status" class="hp-status"></p>
      </form>
      <div class="or">или</div>
      <a class="btn btn-ghost" href="https://t.me/pichugster" target="_blank" rel="noopener">✈ Написать в Telegram</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <b>pichugster</b>
    <div class="links"><a href="/montazh">Монтаж</a><a href="/uslugi">Услуги</a><a href="/zarabotok">Обучение</a><a href="/strany">Страны</a><a href="https://t.me/pichugster" target="_blank" rel="noopener">Telegram</a></div>
    <div class="meta">© 2026 pichugster · the sky has no borders</div>
  </div>
</footer>

<script>
  document.querySelector('.burger').addEventListener('click',function(){
    var l=document.querySelector('.nav-links');
    var open=l.style.display==='flex';
    l.style.display=open?'none':'flex';
    if(!open){Object.assign(l.style,{position:'absolute',top:'60px',left:'0',right:'0',flexDirection:'column',gap:'0',background:'#0A0E1A',borderBottom:'1px solid rgba(255,255,255,.08)',padding:'8px 0'});
      l.querySelectorAll('a').forEach(function(a){a.style.padding='12px 28px'});}
  });
</script>
<script is:inline>
  (function(){
    var form=document.getElementById('order-form');var s=document.getElementById('order-status');
    if(!form) return;
    form.addEventListener('submit',async function(e){
      e.preventDefault();
      if(form.action.indexOf('REPLACE_ME')>-1){s.textContent='Форма ещё не подключена.';s.className='hp-status err';return;}
      s.textContent='Отправляю…';s.className='hp-status';
      try{var r=await fetch(form.action,{method:'POST',body:new FormData(form),headers:{Accept:'application/json'}});
        if(r.ok){form.reset();s.textContent='Заявка отправлена — скоро ответим. Спасибо!';s.className='hp-status ok';}
        else{s.textContent='Не удалось отправить. Попробуйте позже.';s.className='hp-status err';}
      }catch(err){s.textContent='Не удалось отправить. Проверьте соединение.';s.className='hp-status err';}
    });
  })();
</script>
</body>
</html>
