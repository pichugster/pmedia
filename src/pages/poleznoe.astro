---
import Base from "../layouts/Base.astro";
import ProductLadder from "../components/ProductLadder.astro";
import { getCollection } from "astro:content";
import { RUBRICS } from "../data/rubrics.js";
const RUBRIC = "poleznoe";
const r = RUBRICS[RUBRIC];
const guides = (await getCollection("guides", ({ data }) => !data.draft && data.rubric === RUBRIC))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${r.title} · pichugster`} description={r.intro} current={r.path}>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow"><span class="dot"></span>{r.label}{r.soon && <span class="soon">Скоро</span>}</span>
      <h1>{r.title}</h1>
      <p>{r.intro}</p>
    </div>
  </section>

  {r.topics && (
    <section class="band" style="padding-top:44px;padding-bottom:38px">
      <div class="wrap">
        <div class="sec-head" style="margin-bottom:24px">
          <span class="eyebrow"><span class="dot"></span>Что здесь будет</span>
          <h2>Скоро в этом разделе</h2>
          <p>Готовлю материалы и гайды по этим темам. Подпишись — пришлю, когда откроется.</p>
        </div>
        <div class="topic-grid">
          {r.topics.map((t) => (<div class="topic-card"><span class="tdot"></span>{t}</div>))}
        </div>
      </div>
    </section>
  )}

  {guides.length > 0 && (
    <section class="band" style="padding-top:0">
      <div class="wrap">
        <div class="sec-head" style="margin-bottom:24px">
          <span class="eyebrow"><span class="dot"></span>Статьи</span>
          <h2>Полезные материалы</h2>
        </div>
        <div class="guide-grid">
          {guides.map((g) => (
            <a class="guide-card" href={`/guide/${g.slug}`}>
              <span class="cat">{g.data.category}</span>
              <h3>{g.data.title}</h3>
              <p>{g.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <ProductLadder rubric={RUBRIC} />

  <section class="band" style="padding-top:20px">
    <div class="wrap" style="text-align:center;max-width:620px;margin:0 auto">
      <h2 style="font-family:var(--display);font-weight:600;font-size:1.6rem;letter-spacing:-.01em;margin-bottom:10px">Не пропусти запуск раздела</h2>
      <p style="color:var(--slate);margin-bottom:22px">Подпишись — сообщу, когда здесь появятся гайды и продукты.</p>
      <a class="btn btn-primary" href="/#sub">Подписаться</a>
    </div>
  </section>
</Base>
<style>
  .soon{display:inline-block;margin-left:10px;font-family:var(--mono);font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;padding:3px 9px;border-radius:999px;background:linear-gradient(135deg,#FF7E6B,#FB7BA2);color:#fff;vertical-align:middle}
  .topic-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
  .topic-card{display:flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:12px;padding:14px 16px;background:var(--panel);font-family:var(--display);font-weight:500;font-size:.95rem;color:var(--midnight)}
  .tdot{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,#2563EB,#8B5CF6);flex:none}
  @media(max-width:900px){.topic-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.topic-grid{grid-template-columns:1fr}}
</style>
