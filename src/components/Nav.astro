---
// Шапка сайта. Ссылки ведут на разделы. Меняешь пункты здесь — меняются на всех страницах.
const { current = "" } = Astro.props;
const links = [
  { href: "/bloger",     label: "Стать блогером" },
  { href: "/montazh",    label: "Навыки монтажа" },
  { href: "/zarabotok",  label: "Заработок на ИИ" },
  { href: "/strany",     label: "Страны" },
  { href: "/udalyonka",  label: "Удалёнка" },
  { href: "/poleznoe",   label: "Полезное" },
];
---
<nav class="site">
  <a class="brand" href="/">
    <img class="brand-logo" src="/logo.png" alt="" />
    <span class="brand-name">pichug<b>ster</b></span>
  </a>
  <div class="nav-links" id="navLinks">
    {links.map((l) => (
      <a href={l.href} aria-current={current === l.href ? "page" : undefined}>{l.label}</a>
    ))}
  </div>
  <a class="nav-cta" href="/pichugster-ai-start.pdf" download>Забрать гайд</a>
  <button class="burger" id="burger" aria-label="Меню">☰</button>
</nav>
<script>
  const b = document.getElementById('burger');
  const l = document.getElementById('navLinks');
  b && b.addEventListener('click', () => {
    const open = l.style.display === 'flex';
    l.style.display = open ? 'none' : 'flex';
    if (!open) {
      Object.assign(l.style, { position:'absolute', top:'56px', left:'0', right:'0',
        flexDirection:'column', gap:'0', background:'var(--cloud)', borderBottom:'1px solid var(--line)' });
      l.querySelectorAll('a').forEach((a) => { a.style.padding='14px 28px'; a.style.borderTop='1px solid var(--line)'; });
    }
  });
</script>
